{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // React Compiler advisories (the compiler is not enabled for this app).
      // These three are per-frame render engines by design: they mutate
      // ref-held uniform/scratch objects (Scene) and keep a mutable clock plus
      // refs read during render to drive layout/animation (the lyric views).
      // Rewriting them to be compiler-pure would change how they work, not fix
      // a bug, so the two purity rules are off for these files only.
      "files": [
        "src/components/Scene.tsx",
        "src/components/AmbientLyrics.tsx",
        "src/components/BratLyrics.tsx"
      ],
      "rules": {
        "react/immutability": "off",
        "react/refs": "off"
      }
    }
  ]
}
