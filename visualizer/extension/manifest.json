{
  "manifest_version": 3,
  "name": "Visualizer Audio Bridge",
  "version": "1.0.0",
  "description": "Analyzes audio from the active tab for Visualizer.exe.",
  "permissions": ["tabCapture", "offscreen", "tabs"],
  "host_permissions": ["http://127.0.0.1:5173/*", "http://localhost:5173/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Start Visualizer audio capture"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5173/*", "http://localhost:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
