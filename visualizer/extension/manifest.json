{
  "manifest_version": 3,
  "name": "wavi.lol Audio Bridge",
  "version": "1.0.1",
  "description": "Analyzes audio from the active tab for wavi.lol.",
  "permissions": ["tabCapture", "offscreen", "tabs"],
  "host_permissions": ["http://127.0.0.1:5173/*", "http://localhost:5173/*", "https://*.pages.dev/*", "https://wavi.lol/*", "https://www.wavi.lol/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Start Visualizer audio capture"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5173/*", "http://localhost:5173/*", "https://*.pages.dev/*", "https://wavi.lol/*", "https://www.wavi.lol/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}